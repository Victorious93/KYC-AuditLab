<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed to inspect other installed packages on API 30+ (package visibility). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Package visibility for the VictorLaunch fleet theme provider (read-only). -->
    <queries>
        <package android:name="com.victorious.launch" />
        <provider android:authorities="com.victorious.launch.theme" />
    </queries>
    <application
        android:label="IdentityShield Companion"
        android:allowBackup="false">
        <!-- Offline Help screen (static text, no permissions, no network). -->
        <activity
            android:name=".HelpActivity"
            android:label="IdentityShield Help"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Fleet theme wake-up. Exported because VictorLaunch sends it explicitly to
             this package. Extras are ignored; it only triggers a read-only re-query of
             the pin-verified theme provider. -->
        <receiver
            android:name=".fleet.FleetThemeChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.victorious.launch.action.FLEET_THEME_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Entry point for the backend adb harness (am instrument -w). -->
    <instrumentation
        android:name=".IntegrityInstrumentation"
        android:targetPackage="com.identityshield.companion"
        android:label="IdentityShield integrity checks" />
</manifest>
