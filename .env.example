# Copy to .env (git-ignored) and fill in. Never commit real keys.

IDENTITYSHIELD_ENV=local
DATABASE_URL=sqlite:///./identityshield.db
IDENTITYSHIELD_ALLOWED_TARGETS=localhost,127.0.0.1
IDENTITYSHIELD_LOCAL_ONLY=true
IDENTITYSHIELD_EVIDENCE_DIR=./evidence
IDENTITYSHIELD_SIMULATOR_URL=http://localhost:8000/simulator
IDENTITYSHIELD_SIM_VULNERABLE=true

# --- API authentication (X-API-Key header) -------------------------------
# Comma-separated entries: identity:roles:sha256hex
#   roles = admin | operator | admin+operator   (not hierarchical)
#   admin    -> /scope, /simulator/admin/*
#   operator -> /tests/*, /results/*
# Hash a key:  cd backend && python -m app.auth hash "<key>"
# If no valid keys are configured, protected routes fail closed (503).
IDENTITYSHIELD_API_KEYS=

# LOCAL DEV ONLY: same format but with the PLAINTEXT key as the last field.
# Honoured only when IDENTITYSHIELD_ENV=local; ignored otherwise.
# IDENTITYSHIELD_DEV_API_KEYS=dev:admin+operator:change-me-dev-key

# Browser origins allowed to call the API (CORS), comma-separated, explicit
# only ("*" is refused). Default: the dashboard dev server.
IDENTITYSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dashboard. WARNING: Vite inlines VITE_API_KEY into the JavaScript bundle it
# serves, so anyone who can load the dashboard can read the key. Use a
# dedicated local-only key, keep the dashboard on 127.0.0.1, and never serve
# a bundle built with a real key to anyone else.
VITE_API_BASE_URL=http://localhost:8000
# VITE_API_KEY=change-me-dev-key

# --- Postgres (docker-compose.yml only) ----------------------------------
# Required by docker compose; it refuses to start if USER/PASSWORD are unset.
# URL-encode the password if it contains @ : / % (it is interpolated into DATABASE_URL).
POSTGRES_USER=identityshield
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=identityshield
