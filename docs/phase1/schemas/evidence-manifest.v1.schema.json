{
  "$defs": {
    "TestStatusEntry": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "status": {
          "description": "One of the RunStatus/traceability vocabulary values: pending, running, pass, fail, blocked, unsupported, skipped, flaky, unavailable, not-run, error.",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "status"
      ],
      "title": "TestStatusEntry",
      "type": "object"
    }
  },
  "properties": {
    "approval_references": {
      "description": "Paths to approval records, e.g. ['docs/phase1/decisions/0001-single-operator-process.md'].",
      "items": {
        "type": "string"
      },
      "title": "Approval References",
      "type": "array"
    },
    "artifact_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "path -> sha256 for every file under this evidence package.",
      "title": "Artifact Hashes",
      "type": "object"
    },
    "commit": {
      "description": "Full git commit SHA this evidence package was built from.",
      "title": "Commit",
      "type": "string"
    },
    "config_hash": {
      "description": "Hash of the ExecutionConfigV1 instance used for this run.",
      "title": "Config Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fixture_ids": {
      "description": "FixtureMetadataV1.fixture_id values used.",
      "items": {
        "type": "string"
      },
      "title": "Fixture Ids",
      "type": "array"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "test_statuses": {
      "items": {
        "$ref": "#/$defs/TestStatusEntry"
      },
      "title": "Test Statuses",
      "type": "array"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "e.g. {'python': '3.13.x', 'pytest': '8.3.3', 'node': '20.x'}",
      "title": "Tool Versions",
      "type": "object"
    }
  },
  "required": [
    "release_id",
    "commit",
    "created_at",
    "tool_versions",
    "config_hash"
  ],
  "title": "EvidenceManifestV1",
  "type": "object"
}
